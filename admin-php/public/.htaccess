# Admin panel web root (.../yonetim/). Front-controller routing for /api.
DirectoryIndex index.html

# Local/ngrok development must always serve the current admin UI.
# The admin panel is not a public performance-critical surface, so stale
# browser/proxy caches are more harmful than revalidation cost here.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json|map)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>
FileETag None

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pretty login URL -> static login page
  RewriteRule ^login/?$ login.html [L]

  # All /api/* requests go through the PHP front controller
  RewriteRule ^api(/.*)?$ api.php [QSA,L]
</IfModule>

# Never serve the raw config or source if symlinked in by mistake
<FilesMatch "\.(sql|md)$">
  Require all denied
</FilesMatch>
